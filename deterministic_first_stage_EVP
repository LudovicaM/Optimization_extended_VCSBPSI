from gurobipy import *
import time
import json

# deterministic step used to fix the allocation of bins in the first stage
# the model uses in input deterministic data, created from the average of some parameters.
# The bins selected for this model will then be used in a montecarlo simulation, to see how the model deal
# with uncertainty, once introduced with stochastic items.

with open('instances_det_json/instance_Sp1_s38.json', 'r') as f:
    data = json.load(f)

# Spread type - in this case alfa is not considered as it is part of the second-stage
# neither is considered the number of scenarios, as using deterministic data only one deterministic scenario is possible
spread_type = data['spread_type']

# Extraction of bins
bins = data['bins']
"""
print("__BINS__")
for b in bins:
    print(f"Volume: {b['volume']}, Cost: {b['cost']}, "
          f"Length: {b['length']}, Weight: {b['weight']}, Quantity: {b['quantity']}")
"""
expanded_bins = [] #list which will contain the full number of bins. This will be used from now on
for b in bins:
    bin_copy = b.copy()
    quantity = bin_copy.pop('quantity')
    for q in range(quantity):
        expanded_bins.append(bin_copy.copy())

# stampa per controllo
print("__BINS__")
for i, b in enumerate(expanded_bins):
    print(f"Bin {i}: Volume: {b['volume']}, Cost: {b['cost']}, "
          f"Length: {b['length']}, Weight: {b['weight']}")

# Estrai gli items
items = data['items']
print("\n__ITEMS__")
for i, item in enumerate(items):
    print(f"Item {i+1}: Volume: {item['volume']}, "
          f"Category: {item['category']}, Length: {item['length']}, Weight: {item['weight']}")


# DETERMINISTIC PARAMETERS TO FIX BINS IN FIRST STAGE
# Sets
I = list(range(len(items))) # set of items
J = list(range(len(expanded_bins))) # set of available bins
T = ['S', 'M', 'B']    # Item types
# Parameters for items
v = {i: item["volume"] for i, item in enumerate(items)}
w = {i: item["weight"] for i, item in enumerate(items)}
l = {i: item["length"] for i, item in enumerate(items)}
lam = {i: item["category"] for i, item in enumerate(items)}
# parameters for bins available at first stage
Vj = {b: bin["volume"] for b, bin in enumerate(expanded_bins)}
Wj = {b: bin["weight"] for b, bin in enumerate(expanded_bins)}
Lj = {b: bin["length"] for b, bin in enumerate(expanded_bins)}
fj = {b: bin["cost"] for b, bin in enumerate(expanded_bins)}
R_jt = {}
dividers = {'S': 10, 'M': 25, 'B': 40}
for bin_id, volume in Vj.items():
    for type, divider in dividers.items():
        R_jt[(bin_id, type)] = volume // divider

# Model
model = Model("VCSBPSI_determinstic")

# Decision Variables
x = model.addVars(I, J, vtype=GRB.BINARY, name="x")
y = model.addVars(J, vtype=GRB.BINARY, name="y")

# Objective
model.setObjective(
    quicksum(fj[j]*y[j] for j in J),
    GRB.MINIMIZE
)

# Constraints

# (4) Each item assigned to one bin
for i in I:
    model.addConstr(quicksum(x[i, b] for b in J) == 1)

# (5) Volume constraint in first-stage bins
for j in J:
    model.addConstr(quicksum(v[i]*x[i, j] for i in I) <= Vj[j]*y[j])

# (7)-(8) Weight constraints
for j in J:
    model.addConstr(quicksum(w[i]*x[i, j] for i in I) <= Wj[j]*y[j])

# (9)-(10) Max items per type
for t in T:
    for j in J:
        model.addConstr(quicksum(x[i, j] for i in I if lam[i] == t) <= R_jt[j, t])


# (11)-(12) Length constraints
for j in J:
    model.addConstr(quicksum(l[i]*x[i, j] for i in I) <= Lj[j]*y[j])

# (15)-(16) Type homogeneity (big-M)
for b in J:
    for t in T:
        for i in I:
            if lam[i] == t:
                M = sum(1 for i2 in I if lam[i2] != t)
                model.addConstr(
                    quicksum(x[i2, b] for i2 in I if lam[i2] != t) <= M * (1 - x[i, b])
                )

# Time limit [can be removed if not necessary]
model.setParam("TimeLimit", 900)
start_time = time.time()
# Optimize
model.optimize()

end_time = time.time()
# computation of execution time (could be useful for comparison with heuristics)
execution_time = end_time - start_time

# time limit reached -> approximated solution
if model.Status == GRB.TIME_LIMIT:
    print("Tempo limite raggiunto, soluzione approssimata.")

# infeasibility case
if model.status == GRB.INFEASIBLE:
    print("Model is infeasible. Computing IIS...")
    model.computeIIS()
    model.write("model.ilp")         # esporta il modello
    model.write("infeasible.ilp")    # esporta il sistema infeasible
else: #optimality reached
    # print on console -> desired output
    print("sample size (I): %d" % len(I))
    # list of selected bins
    for j in J:
        if y[j].X == 1:  # bin j is used
            print(f"Bin {j} used:")
            items_in_bin = [i for i in I if x[i, j].X == 1]
            print(f"  Items: {items_in_bin}")

    if model.Status == GRB.OPTIMAL or model.Status == GRB.TIME_LIMIT:
        tot_cost = model.ObjVal
        print(f"Objective function: {tot_cost}")
    else:
        print("No optimal solution found.")
    print("Resolution time: {}\n".format(execution_time))
